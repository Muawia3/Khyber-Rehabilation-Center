# ==============================================================================
# Khyber Rehabilitation Center, Peshawar - Environment Template
# Copy this file to .env in root or backend/ and frontend/
# ==============================================================================

# -----------------
# Server Configuration (Backend)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# -----------------
# Database Configuration (PostgreSQL + Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------
DATABASE_URL=postgresql://postgres:password123@localhost:5432/khyber_rehab_db?schema=public

# -----------------
# Rate Limiting & Anti-Spam
# -----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
INQUIRY_RATE_LIMIT_MAX=5

# -----------------
# Admin Initial Seed Credentials
# Note: Seed will ONLY create an admin if explicitly provided here.
# -----------------
INITIAL_ADMIN_EMAIL=admin@khyberrehab.edu.pk
INITIAL_ADMIN_PASSWORD=YourStrongPasswordHere!
INITIAL_ADMIN_NAME="System Administrator"

# -----------------
# Security & JWT Authentication (Prepared for Phase 4)
# -----------------
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# -----------------
# Client Configuration (Frontend - Vite)
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
